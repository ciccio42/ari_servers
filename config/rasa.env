# Configuration of the RASA server: language, OpenAI and RAG of the social bot, flags of the demo. Edit it here:
# bash rasa/docker/run.bash start reads it (RASA_ENV_FILE for another file). After a change: stop, then start.
# A variable exported in the shell overrides the value of this file.
#
# This file is versioned: NO keys here. OPENAI_API_KEY goes in config/secrets.env (not versioned), read together
# with this file:   echo 'OPENAI_API_KEY=sk-...' > config/secrets.env && chmod 600 config/secrets.env
#
# Format of docker --env-file: one VARIABLE=value per line, no quotes (they would become part of the value),
# no comments after the value. A commented line (#) leaves the default of the code, written next to it.
# The ports and the lock of the proxy are in config/servers.yaml (section rasa), not here.

# ----------------------------------------------------------------------------------------------------- demo
# Italian or English: models of models/rasa/<bot>/<it|en> and phrases of the actions
DEMO_LANGUAGE=Italian
# maximum length of the answers asked in the prompts, in characters
MAX_CHAR=250
# True: action_add_info_kg uses the knowledge graph; False: those requests go to action_social. Exactly True/False
KNOWLEDGE_GRAPH_RUNNING=False
# true: the actions write prompts and answers in files of rasa/bots/social (prompt.txt, response_time.txt, ...)
DEBUG=false

# --------------------------------------------------------------------------------------------------- OpenAI
# OPENAI_API_KEY: in config/secrets.env, not here. Needed: without it run.bash start refuses to start
# model of the answers (action_social, action_gpt_4o). Default of the code: gpt-4o-mini; the demo used gpt-4o
OPENAI_MODEL=gpt-4o
# reasoning effort, only for gpt-5, o1, o3, o4: minimal, low, medium, high
#OPENAI_REASONING_EFFORT=low
# temperature 0-2 of the answers without RAG, only for the non-reasoning models (gpt-4o, gpt-4o-mini)
#OPENAI_TEMPERATURE=0.3

# ------------------------------------------------------------------------------- RAG (file_search of OpenAI)
# true: action_social searches the diabetology and cardiology documents of the vector store before answering
# (Responses API); false: it answers with the general knowledge of OPENAI_MODEL, faster, and the RAG settings
# below are not used
OPENAI_FILE_SEARCH=false
# vector store with the documents
#OPENAI_VECTOR_STORE_ID=vs_6adf80ee4cf481919b35fecdd7d1efd9
# model of the RAG answers; default: OPENAI_MODEL
#OPENAI_RAG_MODEL=gpt-4o
# reasoning effort of OPENAI_RAG_MODEL, only for the reasoning models; default: OPENAI_REASONING_EFFORT
#OPENAI_RAG_REASONING_EFFORT=low
# passages returned by every search, 1-50: more passages, more tokens and latency
#OPENAI_FILE_SEARCH_MAX_RESULTS=5
# required: always search before answering; auto: the model decides (it searched 8 times out of 22 test questions)
#OPENAI_FILE_SEARCH_TOOL_CHOICE=required
# passages with a relevance score below this (0-1) are discarded; default: no threshold
#OPENAI_FILE_SEARCH_SCORE_THRESHOLD=0.3
# ranker of the results: auto or a named one (e.g. default-2024-11-15); default: the one of OpenAI
#OPENAI_FILE_SEARCH_RANKER=auto
# limit of generated tokens, reasoning included; default: no limit
#OPENAI_RAG_MAX_OUTPUT_TOKENS=1000
# temperature 0-2 of the RAG answers, only for the non-reasoning models; default: the one of OpenAI (1)
#OPENAI_RAG_TEMPERATURE=0.3
# length of the answers of the gpt-5 models: low, medium, high; default: medium
#OPENAI_RAG_VERBOSITY=low

# --------------------------------------------------------------------------------------- processes (rarely)
# <bot>:<internal port>: they must match the upstreams of rasa.routes in config/servers.yaml
#RASA_BOTS=social:5012 rock_paper_scissor:5013 connect_four:5014
# port of the action server: as action_endpoint of rasa/bots/social/config/endpoints.yml
#ACTIONS_PORT=5055
