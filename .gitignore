# exported models (GBs), created at the first start; models/silero/silero_vad.onnx is versioned
models/whisper/
latency_logs/
__pycache__/
*.pyc
run/
# trained Rasa models (tens of MB each): models/rasa/<bot>/<it|en>/*.tar.gz, from PepperDemo or rasa/docker/run.bash train
models/rasa/
rasa/bots/*/.rasa/
# written by the actions of the social bot with DEBUG=True
rasa/bots/social/*.txt
# secrets of the servers (OPENAI_API_KEY of the RASA server): never versioned
config/secrets.env
# Piper voices (60 MB each), copied from ari_control/ros2_ws/src/ari_tts_action_server/models
models/piper/*.onnx
*csv
rag_knowledge_base/
# models of Ollama (tens of GB) and the Hugging Face cache of the RAG servers (BGE-M3, reranker)
models/ollama/
models/rag/
